#!/usr/bin/env bash
# Usage: hxp-fwd <source-file> <line> [col]

set -u

src="${1:-}"
line="${2:-}"
col="${3:-1}"

if [[ -z "$src" || -z "$line" ]]; then
  printf 'usage: hxp-fwd <source-file> <line> [col]\n' >&2
  exit 2
fi
[[ -z "$col" ]] && col=1

# Helix supplies quoted ~/ paths.
[[ "$src" == \~/* ]] && src="$HOME/${src#\~/}"

warn() {
  command -v notify-send >/dev/null 2>&1 && notify-send "hxp-fwd" "$1" 2>/dev/null
  printf 'hxp-fwd: %s\n' "$1" >&2
}

src="$(realpath -m -- "$src" 2>/dev/null || printf '%s' "$src")"
dir="${src%/*}"
base="${src##*/}"
stem="${base%.*}"
ext=""
[[ "$base" == *.* ]] && ext="${base##*.}"
ext="${ext,,}"

state_dir="${XDG_RUNTIME_DIR:-/tmp}/hxp"
state_key="$(printf '%s' "$src" | sha1sum | cut -d' ' -f1)"
state_file="$state_dir/$state_key.state"

state_src=""; state_pdf=""; state_viewer=""; state_pid=""
state_viewer_pid=""
state_viewer_windowid=""; state_window_known=0

read_state() {
  state_socket=""; state_src=""; state_pdf=""; state_viewer=""; state_pid=""
  state_tmux=""; state_viewer_pane=""
  state_viewer_pid=""
  state_viewer_windowid=""; state_window_known=0
  [[ -r "$1" ]] || return 1
  while IFS='=' read -r k v; do
    case "$k" in
      src)    state_src="$v" ;;
      pdf)    state_pdf="$v" ;;
      viewer) state_viewer="$v" ;;
      viewer_socket) state_socket="$v" ;;
      tmux) state_tmux="$v" ;;
      viewer_pane) state_viewer_pane="$v" ;;
      viewer_pid) state_viewer_pid="$v" ;;
      viewer_windowid) state_viewer_windowid="$v"; state_window_known=1 ;;
      pid)    state_pid="$v" ;;
    esac
  done < "$1"
}

pid_alive() {
  [[ -n "${1:-}" ]] || return 1
  kill -0 "$1" 2>/dev/null
}

read_state "$state_file"
if [[ -n "$state_pid" ]] && ! pid_alive "$state_pid"; then
  rm -f -- "$state_file" "$state_file.buf" 2>/dev/null
  state_pdf=""; state_viewer=""
  state_viewer_pid=""
  state_viewer_windowid=""; state_window_known=0
fi

if [[ -z "$state_pdf" ]]; then
  for sf in "$state_dir"/*.state; do
    [[ -r "$sf" && "$sf" != "$state_file" ]] || continue
    read_state "$sf"
    if [[ -z "$state_src" ]]; then
      state_pdf=""; state_viewer=""; state_viewer_pid=""; state_viewer_windowid=""; state_window_known=0; continue
    fi
    if [[ -n "$state_pid" ]] && ! pid_alive "$state_pid"; then
      rm -f -- "$sf" "$sf.buf" 2>/dev/null
      state_pdf=""; state_viewer=""; state_viewer_pid=""; state_viewer_windowid=""; state_window_known=0; continue
    fi
    sf_dir="$(dirname "$(realpath -m -- "$state_src" 2>/dev/null || printf '%s' "$state_src")")"
    case "$dir" in
      "$sf_dir"|"$sf_dir"/*) break ;;
    esac
    state_pdf=""; state_viewer=""
    state_viewer_pid=""
    state_viewer_windowid=""; state_window_known=0
  done
fi

pdf="$state_pdf"

if [[ -z "$pdf" || ! -f "$pdf" ]]; then
  pdf=""
  candidates=("$dir/$stem.pdf")
  cur="$dir"
  while [[ -n "$cur" && "$cur" != "/" ]]; do
    for n in main.tex main.typ root.tex thesis.tex; do
      if [[ -f "$cur/$n" ]]; then
        candidates+=("$cur/${n%.*}.pdf")
        break 2
      fi
    done
    cur="$(dirname "$cur")"
  done
  for c in "${candidates[@]}"; do
    [[ -f "$c" ]] && { pdf="$c"; break; }
  done
fi

if [[ -z "$pdf" ]]; then
  warn "no PDF found for $base"
  exit 1
fi

sync_file="$src"
sync_line="$line"
sync_col="$col"

search_page=""
focus_text=""

# Cache page text by PDF identity; rebuilds replace the file.
pdf_text() {
  local cache id cached tmp
  cache="$state_dir/$(printf '%s' "$pdf" | sha1sum | cut -d' ' -f1).pdftext"
  id="$(stat -c '%d:%i:%s:%y' -- "$pdf" 2>/dev/null)" || return 1
  if [[ -r "$cache" ]] && IFS= read -r cached < "$cache" && [[ "$cached" == "$id" ]]; then
    tail -n +2 -- "$cache"
    return 0
  fi
  mkdir -p -- "$state_dir" 2>/dev/null
  tmp="$cache.$$"
  if { printf '%s\n' "$id" && pdftotext -q "$pdf" - 2>/dev/null; } > "$tmp" &&
     [[ "$(stat -c '%d:%i:%s:%y' -- "$pdf" 2>/dev/null)" == "$id" ]] && mv -f -- "$tmp" "$cache"; then
    tail -n +2 -- "$cache"
    return 0
  fi
  rm -f -- "$tmp"
  pdftotext -q "$pdf" - 2>/dev/null
}

typst_search_page() {
  command -v pdftotext >/dev/null 2>&1 || return 1
  command -v hxp-typtext >/dev/null 2>&1 || return 1

  pdf_text | awk '
    FILENAME == ARGV[1] {
      tab = index($0, "\t")
      if (!tab) next
      offset[++n] = substr($0, 1, tab - 1) + 0
      phrase[n] = substr($0, tab + 1)
      next
    }
    {
      ++page
      gsub(/[[:space:]]+/, " ")
      first = score = 0
      for (i = 1; i <= n; ++i) {
        if (!index($0, phrase[i])) continue
        if (!first) first = i
        d = offset[i]
        if (d != offset[first] && seen[d] != page) {
          score += 5 - (d < 0 ? -d : d)
          seen[d] = page
        }
      }
      if (first && (!best || first < best || (first == best && score > high))) {
        best = first
        high = score
        selected = page
      }
    }
    END {
      if (!best) exit 1
      print selected "\t" phrase[best]
    }
  ' <(hxp-typtext "$src" "$line" --context) RS='\f' -
}

case "$ext" in
  md|markdown)
    build_tex="$dir/.hxp_build_$stem/$stem.hxp.tex"
    mapped=""
    if [[ -f "$build_tex" ]] && command -v hxp-texline >/dev/null 2>&1; then
      mapped="$(hxp-texline "$src" "$build_tex" "$line" 2>/dev/null)"
    fi
    if [[ -n "$mapped" ]]; then
      sync_file="$build_tex"
      sync_line="$mapped"
      sync_col=1
    else
      sync_file=""
    fi
    ;;
  typ|typst)
    sync_file=""
    if hit="$(typst_search_page)"; then
      search_page="${hit%%$'\t'*}"
      focus_text="${hit#*$'\t'}"
    fi
    ;;
esac

viewer="$state_viewer"
[[ -z "$viewer" ]] && viewer="${HXP_VIEWER:-}"
if [[ -z "$viewer" ]]; then
  if pgrep -a zathura 2>/dev/null | grep -qF -- "$pdf"; then
    viewer=zathura
  elif pgrep -a sioyek 2>/dev/null | grep -qF -- "$pdf"; then
    viewer=sioyek
  elif command -v zathura >/dev/null 2>&1; then
    viewer=zathura
  elif command -v sioyek >/dev/null 2>&1; then
    viewer=sioyek
  fi
fi

if [[ -z "$viewer" ]] || ! command -v "$viewer" >/dev/null 2>&1; then
  warn "no PDF viewer available"
  exit 1
fi

if [[ "$viewer" == fancy-cat ]]; then
  if [[ -z "$state_pdf" || ! -S "$state_socket" ]]; then
    warn "this session's fancy-cat preview is unavailable"
    exit 1
  fi
  if [[ -n "$sync_file" ]]; then
    fancy-cat --remote "$state_socket" forward-search "$sync_file" "$sync_line" "$sync_col" || exit 1
  elif [[ -n "$search_page" ]]; then
    fancy-cat --remote "$state_socket" goto-page "$search_page" "$focus_text" || exit 1
  else
    warn "no searchable PDF position for this source line"
    exit 1
  fi
  if [[ -n "$state_tmux" && "$state_viewer_pane" =~ ^%[0-9]+$ ]] && command -v tmux >/dev/null 2>&1; then
    tmux -S "${state_tmux%%,*}" select-pane -t "$state_viewer_pane" >/dev/null 2>&1 || true
  fi
  exit 0
fi

zathura_pid_args=()
if [[ "$viewer" == zathura && -n "$state_pdf" ]]; then
  if [[ ! "$state_viewer_pid" =~ ^[1-9][0-9]*$ ]]; then
    warn "Zathura preview process is unknown; restart this hxp session"
    exit 1
  fi
  zathura_pid_args=(--synctex-pid "$state_viewer_pid")
fi

# Legacy title matching must be unambiguous.
raise_viewer_window() {
  command -v wmctrl >/dev/null 2>&1 || return 1
  local want="${pdf##*/}" id
  id="$(wmctrl -lx 2>/dev/null | awk -v b="$want" -v viewer="$viewer" \
      -v owned="$state_viewer_windowid" -v known="$state_window_known" '
    BEGIN { b=tolower(b); viewer=tolower(viewer); owned=tolower(owned) }
    {
      if (index(tolower($3), viewer) == 0) next
      if (known) {
        if (tolower($1) == owned) print $1
        next
      }
      title=""
      for (i=5; i<=NF; i++) title=title " " $i
      if (index(tolower(title), b) > 0) { count++; id=$1 }
    }
    END { if (!known && count == 1) print id }
  ')"
  [[ -n "$id" ]] || return 1
  wmctrl -i -a "$id" >/dev/null 2>&1 || return 1
  sleep 0.05
  return 0
}

# D-Bus pages in place; --page opens a new window.
zathura_goto_page() {
  command -v gdbus >/dev/null 2>&1 || return 1
  local names n fname
  if [[ -n "$state_viewer_pid" ]]; then
    names="org.pwmt.zathura.PID-$state_viewer_pid"
  else
    names="$(gdbus call --session --dest org.freedesktop.DBus \
             --object-path /org/freedesktop/DBus \
             --method org.freedesktop.DBus.ListNames 2>/dev/null \
           | grep -o 'org\.pwmt\.zathura\.PID-[0-9]*' | sort -u)"
  fi
  [[ -n "$names" ]] || return 1
  while IFS= read -r n; do
    [[ -z "$n" ]] && continue
    fname="$(gdbus call --session --dest "$n" --object-path /org/pwmt/zathura \
               --method org.freedesktop.DBus.Properties.Get \
               org.pwmt.zathura filename 2>/dev/null)"
    [[ "$fname" == *"$pdf"* ]] || continue
    gdbus call --session --dest "$n" --object-path /org/pwmt/zathura \
      --method org.pwmt.zathura.GotoPage "$(( $1 - 1 ))" >/dev/null 2>&1 && return 0
  done <<< "$names"
  return 1
}

raised=0
raise_viewer_window && raised=1

if [[ -z "$sync_file" && -z "$search_page" ]]; then
  (( raised )) && exit 0
fi

case "$viewer" in
  sioyek)
    if (( raised )); then
      win_flag=--reuse-window
    else
      win_flag=--new-window
    fi
    if [[ -n "$sync_file" ]]; then
      sioyek "$win_flag" \
             --forward-search-file "$sync_file" \
             --forward-search-line "$sync_line" \
             --forward-search-column "$sync_col" \
             "$pdf" >/dev/null 2>&1 &
    elif [[ -n "$search_page" ]]; then
      sioyek "$win_flag" \
             --page "$search_page" \
             --focus-text "$focus_text" \
             --focus-text-page "$search_page" \
             "$pdf" >/dev/null 2>&1 &
    else
      sioyek "$win_flag" "$pdf" >/dev/null 2>&1 &
    fi
    disown
    ;;
  zathura|*)
    # Never redirect an owned session to another preview.
    if [[ -n "$sync_file" ]]; then
      zathura "${zathura_pid_args[@]}" --synctex-forward "$sync_line:$sync_col:$sync_file" "$pdf" >/dev/null 2>&1 &
      disown
    elif [[ -n "$search_page" ]] && zathura_goto_page "$search_page"; then
      :
    elif [[ -n "$state_viewer_pid" ]]; then
      if [[ -n "$search_page" ]]; then
        warn "could not page this session's Zathura preview"
        exit 1
      fi
    else
      zathura "$pdf" >/dev/null 2>&1 &
      disown
    fi
    ;;
esac

exit 0
