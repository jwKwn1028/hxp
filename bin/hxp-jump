#!/usr/bin/env bash
# Usage: hxp-jump <file>:<line>[:<col>]

set -u

guess_md_line() {
  command -v hxp-mdline >/dev/null 2>&1 || return 0
  hxp-mdline "$1" "$2" "$3"
}

editor="helix"
[[ "${HXP_EDITOR:-}" == "micro" ]] && editor="micro"

spawn_editor() {
  local file="$1" line="${2:-}" col="${3:-}"
  # Terminal editors cannot start from GUI callbacks.
  if [[ ! -t 0 || ! -t 1 ]]; then
    local message="no reachable editor for ${file}${line:+:$line}; run hxp in tmux or keep its editor open"
    command -v notify-send >/dev/null 2>&1 && notify-send "hxp-jump" "$message" 2>/dev/null
    printf 'hxp-jump: %s\n' "$message" >&2
    exit 1
  fi
  case "$editor" in
    micro)
      if [[ -n "$line" ]]; then
        exec micro "+${line}${col:+:$col}" "$file"
      fi
      exec micro "$file"
      ;;
    *)
      if [[ -n "$line" ]]; then
        exec hx "${file}:${line}${col:+:$col}"
      fi
      exec hx "$file"
      ;;
  esac
}

shquote() {
  printf "'%s'" "${1//\'/\'\\\'\'}"
}

target="${1:-}"
[[ -z "$target" ]] && exit 1
if [[ "$target" =~ [[:cntrl:]] ]]; then
  printf 'hxp-jump: control characters are not supported in source locations\n' >&2
  exit 2
fi

# Paths may contain colons; parse from the right.
if [[ "$target" =~ ^(.+):([0-9]+):([0-9]+)$ ]]; then
  file="${BASH_REMATCH[1]}"
  line="${BASH_REMATCH[2]}"
  col="${BASH_REMATCH[3]}"
elif [[ "$target" =~ ^(.+):([0-9]+)$ ]]; then
  file="${BASH_REMATCH[1]}"
  line="${BASH_REMATCH[2]}"
  col=""
else
  if [[ -n "${HXP_PREVIEW_SRC:-}" ]]; then
    printf 'hxp-jump: source location has no line number\n' >&2
    exit 2
  fi
  spawn_editor "$target"
fi

if [[ "$file" == *.hxp.tex ]]; then
  dir_part="${file%/*}"
  base_part="${file##*/}"
  stem="${base_part%.hxp.tex}"

  parent="${dir_part##*/}"
  if [[ "$parent" == .hxp_build_* ]]; then
    dir_part="${dir_part%/*}"
  fi

  md_candidate="$dir_part/$stem.md"

  if [[ -f "$md_candidate" ]]; then
    md_line="$(guess_md_line "$md_candidate" "$file" "$line")"
    file="$md_candidate"
    [[ -n "$md_line" ]] && line="$md_line"
    col=""
  fi
fi

realfile="$(realpath -m -- "$file" 2>/dev/null || printf '%s' "$file")"

state_dir="${XDG_RUNTIME_DIR:-/tmp}/hxp"
state_key="$(printf '%s' "$realfile" | sha1sum | cut -d' ' -f1)"
state_file="$state_dir/$state_key.state"
# Pin fancy-cat previews only; GUI viewers may be shared.
if [[ -n "${HXP_PREVIEW_SRC:-}" ]]; then
  session_src="$(realpath -m -- "$HXP_PREVIEW_SRC")"
  state_key="$(printf '%s' "$session_src" | sha1sum | cut -d' ' -f1)"
  state_file="$state_dir/$state_key.state"
fi

pid_alive() {
  [[ -n "${1:-}" ]] || return 1
  [[ "$1" =~ ^[1-9][0-9]*$ ]] && kill -0 "$1" 2>/dev/null || return 1
  if [[ -n "${state_pid_start:-}" ]]; then
    local stat
    IFS= read -r stat < "/proc/$1/stat" || return 1
    stat="${stat##*) }"
    read -r -a fields <<< "$stat"
    [[ "${fields[19]:-}" == "$state_pid_start" ]] || return 1
  fi
}

clear_targets() {
  tmux_socket=""
  tmux_pane=""
  window_id=""
  ghostty_split=""
  state_viewer=""
  state_editor=""
}

read_state() {
  clear_targets
  state_pid=""
  state_pid_start=""
  state_src=""
  [[ -r "$1" ]] || return 1
  while IFS='=' read -r k v; do
    case "$k" in
      src)       state_src="$v" ;;
      tmux)      tmux_socket="$v" ;;
      tmux_pane) tmux_pane="$v" ;;
      windowid)  window_id="$v" ;;
      ghostty_split) ghostty_split="$v" ;;
      viewer)    state_viewer="$v" ;;
      editor)    state_editor="$v" ;;
      pid)       state_pid="$v" ;;
      pid_start) state_pid_start="$v" ;;
    esac
  done < "$1"
}

read_state "$state_file"

if [[ -n "$state_pid" ]] && ! pid_alive "$state_pid"; then
  rm -f -- "$state_file" "$state_file.buf" 2>/dev/null || true
  clear_targets
fi

if [[ -n "${HXP_PREVIEW_SRC:-}" ]] && { [[ "$state_src" != "$session_src" ]] || ! pid_alive "$state_pid"; }; then
  printf 'hxp-jump: originating session is unavailable\n' >&2
  exit 1
fi

# Search ancestor sessions only for unpinned previews.
if [[ -z "${HXP_PREVIEW_SRC:-}" && -z "$tmux_pane" && -z "$window_id" ]]; then
  reported_dir="$(dirname "$realfile")"
  for sf in "$state_dir"/*.state; do
    [[ -r "$sf" && "$sf" != "$state_file" ]] || continue
    read_state "$sf"
    if [[ -z "$state_src" ]]; then
      clear_targets; continue
    fi
    if [[ -n "$state_pid" ]] && ! pid_alive "$state_pid"; then
      rm -f -- "$sf" "$sf.buf" 2>/dev/null || true
      clear_targets; continue
    fi
    sf_dir="$(dirname "$(realpath -m -- "$state_src" 2>/dev/null || printf '%s' "$state_src")")"
    case "$reported_dir" in
      "$sf_dir"|"$sf_dir"/*)
        state_file="$sf"
        break ;;
    esac
    clear_targets
  done
fi

case "$state_editor" in
  micro)    editor=micro ;;
  helix|hx) editor=helix ;;
esac

target_str="$realfile:$line"
[[ -n "$col" ]] && target_str="$target_str:$col"

# Reopening Micro buffers discards undo history.
buf_file="$state_file.buf"
current_buf=""
[[ -r "$buf_file" ]] && IFS= read -r current_buf < "$buf_file"
[[ -z "$current_buf" ]] && current_buf="$state_src"

need_open=1
[[ -n "$current_buf" && "$current_buf" == "$realfile" ]] && need_open=0

remember_buffer() {
  [[ "$editor" == "micro" && -n "$state_src" ]] || return 0
  printf '%s\n' "$realfile" >| "$buf_file" 2>/dev/null || true
}

# Micro needs an Escape/Alt disambiguation pause.
ESC_SETTLE=0.1

tmux_cmd() { tmux -S "${tmux_socket%%,*}" "$@"; }
tsend() { tmux_cmd send-keys -t "$tmux_pane" "$@" 2>/dev/null; }
type_command() { tsend -l -- "$1" && tsend Enter; }
helix_quote() {
  # Helix doubles literal single quotes.
  printf "'%s'" "${1//\'/\'\'}"
}

drive_tmux() {
  case "$editor" in
    micro)
      tsend Escape || return 1
      sleep "$ESC_SETTLE"
      if (( need_open )); then
        tsend C-e || return 1
        # Micro unquotes filenames twice.
        type_command "open $(shquote "$(shquote "$realfile")")" || return 1
        sleep "$ESC_SETTLE"
      fi
      tsend C-e || return 1
      type_command "goto $line${col:+:$col}" || return 1
      ;;
    *)
      tmux_cmd send-keys -t "$tmux_pane" Escape Escape \; \
        send-keys -l -t "$tmux_pane" -- ":open $(helix_quote "$target_str")" \; \
        send-keys -t "$tmux_pane" Enter 2>/dev/null || return 1
      ;;
  esac
}

if [[ -n "$tmux_socket" && "$tmux_pane" =~ ^%[0-9]+$ ]] && command -v tmux >/dev/null 2>&1; then
  if drive_tmux; then
    remember_buffer
    tmux_cmd select-pane -t "$tmux_pane" >/dev/null 2>&1 || true
    exit 0
  fi
fi

# xdotool needs decimal window IDs.
if [[ "$window_id" == 0x* ]]; then
  window_id=$(printf '%d' "$window_id" 2>/dev/null) || window_id=""
fi
if [[ -n "$window_id" ]] && command -v xdotool >/dev/null 2>&1; then
  xdotool windowactivate --sync "$window_id" 2>/dev/null || true
  sleep 0.05

  if [[ "$ghostty_split" == 1 ]]; then
    # Recheck focus before each keystroke.
    active_editor_window() { [[ "$(xdotool getactivewindow)" == "$window_id" ]]; }
    xkey() { active_editor_window && xdotool key --clearmodifiers "$@"; }
    xtype() { active_editor_window && xdotool type --clearmodifiers --delay 0 "$1"; }
    xkey ctrl+shift+h || exit 1
    sleep 0.05
  else
    xkey() { xdotool key --window "$window_id" "$@" 2>/dev/null; }
    xtype() { xdotool type --window "$window_id" --clearmodifiers --delay 0 "$1" 2>/dev/null; }
  fi

  case "$editor" in
    micro)
      xkey Escape
      sleep "$ESC_SETTLE"
      if (( need_open )); then
        xkey ctrl+e
        sleep 0.02
        xtype "open $(shquote "$(shquote "$realfile")")" && xkey Return
        sleep "$ESC_SETTLE"
      fi
      xkey ctrl+e
      sleep 0.02
      xtype "goto $line${col:+:$col}" && xkey Return && { remember_buffer; exit 0; }
      ;;
    *)
      xkey Escape Escape
      sleep 0.02
      xtype ":open $(helix_quote "$target_str")" && xkey Return && exit 0
      ;;
  esac
fi

# Never spawn an editor in the preview pane.
if [[ "$state_viewer" == fancy-cat || -n "${HXP_PREVIEW_SRC:-}" ]]; then
  printf 'hxp-jump: could not reach the session editor\n' >&2
  exit 1
fi

spawn_editor "$realfile" "$line" "$col"
