# Zathura-style aliases alongside Sioyek defaults.

# Optional dual-panel extension:
# _dual_panelify d

toggle_dark_mode i

# Fit width; Sioyek reserves s for external search.
fit_to_page_width a

screen_down <C-d>
screen_up <C-u>

next_page J
previous_page K

goto_top_of_page H
goto_bottom_of_page L

goto_mark '

reload <C-l>

# Inverse search at the mouse cursor.
synctex_under_cursor <F5>
