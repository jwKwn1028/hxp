# hxp viewer preferences.

auto_reload_preference 1

# PDF-to-editor search.
inverse_search_command hxp-jump %1:%2

# hxp overrides this with --new-window per session.
should_launch_new_window 0
should_launch_new_instance 0

# Optional dual-panel extension; HXP_SIOYEK_VENV selects its venv.
new_command _dual_panelify hxp-dual-panelify "%{sioyek_path}" "%{file_path}" "%{command_text}"
